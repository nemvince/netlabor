{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@web/*": ["../web/src/*"],
      "@docs/*": ["./src/*"]
    },
    "types": ["astro/client"]
  },
  "include": [".astro/types.d.ts", "src", "scripts", "astro.config.mjs"],
  "exclude": ["dist"]
}
