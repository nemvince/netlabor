---
import '@docs/styles/docs.css';
import pkg from '../../package.json';
import DocsNav from '../components/DocsNav.astro';
import DocsRail from '../components/DocsRail.astro';
import Toc from '../components/Toc.astro';
import type { Heading } from '../lib/headings.ts';
import { findNavItem, groupOf, neighbours, normalisePath } from '../lib/nav.ts';

export interface Props {
  title: string;
  description: string;
  headings?: Heading[];
  wide?: boolean;
}

const { title, description, headings = [], wide = false } = Astro.props as Props;

const path = normalisePath(Astro.url.pathname);
const item = findNavItem(path);
const group = item ? groupOf(item) : undefined;
const { previous, next } = neighbours(path);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);

const builtAt = new Date().toISOString().replace('T', ' ').slice(0, 16);
const year = new Date().getUTCFullYear();
const version = pkg.version;
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · Netlabor docs</title>
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23111417'/%3E%3Cpath d='M7 9h9v14H7zM16 16h9' fill='none' stroke='%23ef9a45' stroke-width='2'/%3E%3Ccircle cx='25' cy='16' r='2' fill='%23ef9a45'/%3E%3C/svg%3E"
    />
  </head>
  <body>
    <a class="docs-skip" href="#content">Skip to content</a>
    <div class="docs-shell">
      <DocsRail path={path} />
      <div class="docs-frame">
        <header class="docs-topbar">
          <details class="docs-mobile-nav">
            <summary aria-label="Open documentation navigation">
              <svg
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path d="M4 6h16M4 12h16M4 18h16"></path>
              </svg>
              Menu
            </summary>
            <div class="docs-mobile-nav__panel">
              <DocsNav path={path} />
            </div>
          </details>

          <nav class="docs-crumbs" aria-label="Breadcrumb">
            <a href="/">docs</a>
            {group ? <span class="docs-crumbs__sep">/</span> : null}
            {group ? <span class="docs-crumbs__group">{group.label.toLowerCase()}</span> : null}
            {group ? <span class="docs-crumbs__sep docs-crumbs__group">/</span> : null}
            <span class="docs-crumbs__current">{item?.label ?? title}</span>
          </nav>

          <div class="docs-topbar__right">
            <button type="button" class="docs-search-trigger" data-search-open>
              <svg
                width="11"
                height="11"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <circle cx="11" cy="11" r="7"></circle>
                <path d="m20 20-3.5-3.5"></path>
              </svg>
              Search
              <kbd>⌘K</kbd>
            </button>
            <span class="docs-chip docs-chip--repo" title="Repository and documentation version">
              <span class="docs-chip__dot" aria-hidden="true"></span>
              netlabor
            </span>
            <span class="docs-chip docs-chip--license">AGPL-3.0</span>
            <span>v{version}</span>
          </div>
        </header>

        <div class="docs-scroll">
          <div class:list={['docs-body', { 'docs-body--wide': wide }]}>
            <main id="content" class="docs-article" tabindex="-1">
              <slot />

              {
                previous || next ? (
                  <nav class="docs-pager" aria-label="Previous and next pages">
                    {previous ? (
                      <a href={previous.href}>
                        <span class="docs-pager__dir">← Previous</span>
                        <span class="docs-pager__label">{previous.label}</span>
                      </a>
                    ) : null}
                    {next ? (
                      <a href={next.href} data-dir="next">
                        <span class="docs-pager__dir">Next →</span>
                        <span class="docs-pager__label">{next.label}</span>
                      </a>
                    ) : null}
                  </nav>
                ) : null
              }
            </main>
            {toc.length > 0 ? <Toc headings={toc} /> : null}
          </div>
        </div>

        <footer class="docs-footer">
          <span>© {year} Netlabor contributors · AGPL-3.0-or-later</span>
          <span class="docs-footer__links">
            <a href="/components">Components</a>
            <a href="/theme">Theme</a>
            <a href="/api">API</a>
          </span>
          <span>build {builtAt} UTC · v{version}</span>
        </footer>
      </div>
    </div>

    <script is:inline>
      // Search is a static script loaded on first use, so documentation pages
      // ship no framework runtime until someone actually searches.
      (() => {
        let loading = null;
        const load = () => {
          loading ??= import('/search.js').then(() => window.nbDocsSearch);
          return loading;
        };
        const typing = () => {
          const tag = document.activeElement?.tagName ?? '';
          return tag === 'INPUT' || tag === 'TEXTAREA' || document.activeElement?.isContentEditable;
        };
        document.addEventListener('keydown', (event) => {
          const combo = (event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k';
          const slash = event.key === '/' && !event.metaKey && !event.ctrlKey && !typing();
          if (!combo && !slash) return;
          event.preventDefault();
          void load().then((open) => open?.());
        });
        document.addEventListener('click', (event) => {
          const target = event.target;
          if (!(target instanceof Element) || !target.closest('[data-search-open]')) return;
          event.preventDefault();
          void load().then((open) => open?.());
        });
      })();

      // One shared handler for snippet copy buttons. The React CopyButton has
      // its own state; this keeps static snippets free of per-page scripts.
      document.addEventListener('click', async (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        const button = target.closest('[data-copy]');
        if (!button) return;
        const value = button.getAttribute('data-copy') ?? '';
        const label = button.textContent ?? 'Copy';
        try {
          await navigator.clipboard.writeText(value);
        } catch {
          return;
        }
        button.textContent = 'Copied';
        window.setTimeout(() => {
          button.textContent = label;
        }, 1400);
      });
    </script>
  </body>
</html>
