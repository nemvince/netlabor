---
import DocsNav from './DocsNav.astro';

const { path } = Astro.props as { path: string };
---

<aside class="docs-rail" aria-label="Documentation sidebar">
  <a class="docs-rail__brand" href="/">
    <svg
      class="docs-rail__mark"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M5 6.5h6.5v9H5z"></path>
      <path d="M11.5 11h7.5"></path>
      <circle cx="19" cy="11" r="1.6"></circle>
      <circle cx="5" cy="11" r="1.3"></circle>
    </svg>
    <span class="docs-rail__wordmark">Netlabor</span>
    <span class="docs-rail__suffix">docs</span>
  </a>
  <div class="docs-rail__nav">
    <DocsNav path={path} />
  </div>
  <div class="docs-rail__foot">
    <span>v0.1.0</span>
    <a href="https://www.gnu.org/licenses/agpl-3.0.html" rel="noreferrer">AGPL-3.0</a>
  </div>
</aside>
