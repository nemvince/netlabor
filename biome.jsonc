{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": true,
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.tsbuild",
      "!**/.astro",
      "!**/e2e/assets",
      "!**/test-results",
      "!**/playwright-report",
      "!**/packages/catalog/symbols",
      "!**/.dev",
    ],
  },
  "formatter": {
    "enabled": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
    },
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "warn",
        "noEmptyBlockStatements": "off",
      },
      "style": {
        "noNonNullAssertion": "off",
        "useConst": "error",
        "noParameterAssign": "off",
      },
      "complexity": {
        "noBannedTypes": "off",
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
      },
    },
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on",
      },
    },
  },
  "css": {
    "parser": {
      "tailwindDirectives": true,
    },
  },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off",
          },
        },
      },
    },
    {
      "includes": ["apps/web/src/styles.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off",
          },
        },
      },
    },
    {
      // False positives, not a cascade hazard: five pairings compare `.docs-prose` base rules
      // against rules for the standalone `.docs-callout`, `.docs-toc`, and `.docs-search__panel`
      // components, which never match the same element; the other three compare `.docs-prose`
      // rules that set disjoint declarations (`position` vs `margin`, borders vs `overflow-wrap`),
      // so their order cannot change the result. The two genuinely order-dependent pairs were
      // reordered in the stylesheet. Scoped to this one file.
      "includes": ["apps/docs/src/styles/docs.css"],
      "linter": {
        "rules": {
          "style": {
            "noDescendingSpecificity": "off",
          },
        },
      },
    },
  ],
}
