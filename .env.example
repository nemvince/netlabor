# Netlabor environment. `bun run dev` loads `.env` from the repository root, and the
# packaged services read `/etc/netlabor/controller.env` and `/etc/netlabor/agent.env`.
# Copy this file and replace every `change-me`. Secrets belong in the real file only;
# `.env` is gitignored, this example is not.

# --- shared (controller and agent) ------------------------------------------
# Image storage: `local` keeps blobs on each compute, `nfs` shares NB_NFS_IMAGE_DIR.
NB_STORAGE_DRIVER=local
# Required when NB_STORAGE_DRIVER=nfs.
# NB_NFS_IMAGE_DIR=/srv/netlabor/images
# debug | info | warn | error.
# NB_LOG_LEVEL=info
# PEM pair so the process terminates TLS itself instead of behind a proxy.
# NB_TLS_CERT=/etc/netlabor/tls/cert.pem
# NB_TLS_KEY=/etc/netlabor/tls/key.pem
# Version string reported by /healthz.
# NB_VERSION=0.1.0

# --- controller -------------------------------------------------------------
# PostgreSQL 17 connection string. Required.
NB_DATABASE_URL=postgres://netlabor:change-me@127.0.0.1:5432/netlabor
# 32 random bytes encoded as base64 (`openssl rand -base64 32`). Rotating it
# invalidates sessions, agent tokens, and stored secrets.
NB_SECRET_KEY=Y2hhbmdlLW1lLWNoYW5nZS1tZS1jaGFuZ2UtbWUtIS0=
# host:port the API and UI bind to.
NB_LISTEN=0.0.0.0:8080
# Browser origin of the UI; cookie-authenticated mutations are checked against it.
NB_PUBLIC_URL=http://127.0.0.1:8080
# Built browser bundle the controller serves.
NB_WEB_ROOT=apps/web/dist
# Uploads, blobs, snapshots, and exports; must be writable by the controller user.
NB_STAGING_DIR=/var/lib/netlabor/staging
# Session lifetime in hours.
# NB_SESSION_TTL_HOURS=24
# Close projects with no connected client after this many minutes.
# NB_AUTO_CLOSE_IDLE_MINUTES=10
# First administrator, created on first start only when the password is set.
NB_ADMIN_USER=admin
# NB_ADMIN_PASSWORD=change-me
# Single-line JSON logs instead of pretty output.
# NB_LOG_PRETTY=1
# Ceiling for one upload in bytes.
# NB_MAX_UPLOAD_BYTES=68719476736
# Ceiling for nodes in one project.
# NB_MAX_NODES_PER_PROJECT=500
# Accept plain-http agent URLs (development only).
# NB_ALLOW_INSECURE_AGENT=1
# Accept http OIDC issuers outside loopback (development only).
# NB_ALLOW_INSECURE_OIDC=1
# Disable rate limits (tests only).
# NB_DISABLE_RATE_LIMITS=1

# --- agent ------------------------------------------------------------------
# host:port the agent API binds to.
NB_AGENT_LISTEN=0.0.0.0:8081
# Issued once by the controller when the compute is registered; the controller is
# the only issuer, so rotate from the compute row instead of reusing a lost token.
NB_AGENT_TOKEN=change-me
# Underlay slot (1-254) that gives this compute its /32 in NB_UNDERLAY_CIDR.
NB_UNDERLAY_INDEX=1
# Address the other computes reach this agent's underlay on.
NB_UNDERLAY_HOST=10.99.0.1
# NB_UNDERLAY_CIDR=10.99.0.0/16
# Underlay interface, normally the WireGuard tunnel.
# NB_UNDERLAY_INTERFACE=wg0
# Persistent state and runtime directories; both must be absolute and writable.
# NB_STATE_DIR=/var/lib/netlabor
# NB_RUN_DIR=/run/netlabor
# NB_IMAGE_DIR=/var/lib/netlabor/images
# NB_UBRIDGE_PATH=/usr/local/bin/ubridge
# Administrator-provisioned host bridge for NAT nodes.
# NB_NAT_BRIDGE=nb-nat
# Comma-separated host interfaces NAT nodes may reach the internet through.
# NB_CLOUD_INTERFACES=eth0
# Unprivileged account emulators run as.
# NB_EMULATOR_UID=1001
# NB_EMULATOR_GID=1001
# Docker Engine or rootless Podman socket.
# NB_DOCKER_SOCKET=/var/run/docker.sock
# Pull missing container images when a node starts.
# NB_DOCKER_AUTO_PULL=1
# Concurrent sharkd capture sessions per compute.
# NB_MAX_SHARKD_SESSIONS=8
# Optional controller URL for agent-initiated registration and heartbeats.
# NB_CONTROLLER_URL=http://127.0.0.1:8080
# Cap for one appliance build, in milliseconds (default 90 minutes).
# NB_APPLIANCE_BUILD_TIMEOUT_MS=5400000
